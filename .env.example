# Copy to .env for local development. Do not commit .env.

# Required. Generate a production value with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=local-development-only

# Off unless set. Never enable in production.
DEBUG=True

# Comma-separated hostnames to serve when DEBUG is off. On Render, the service's
# own hostname is added automatically, so this is only needed for custom domains.
# ALLOWED_HOSTS=example.com,www.example.com

# Where the Rebrickable CSV files are, and where to build the catalog from them.
# CATALOG_CSV_DIR=data
# CATALOG_DB=catalog.sqlite3

# Where build_catalog --download fetches the latest files from.
# CATALOG_DOWNLOAD_URL=https://cdn.rebrickable.com/media/downloads/
